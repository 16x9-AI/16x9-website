{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierdesk.ai/schemas/intel-visual-spec/1.1.json",
  "title": "Intel LinkedIn visual spec (layouts F, F flexible, G)",
  "description": "Structured spec for one image. Every displayed string must be verbatim from the note (checked by validate.mjs, not by this schema). Pick the variant from the data shape; see spec/extract_prompt.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/deal"
    },
    {
      "$ref": "#/$defs/credit"
    },
    {
      "$ref": "#/$defs/call"
    },
    {
      "$ref": "#/$defs/stmt"
    },
    {
      "$ref": "#/$defs/gBuildSpec"
    },
    {
      "$ref": "#/$defs/gExplainSpec"
    },
    {
      "$ref": "#/$defs/gWeekSpec"
    },
    {
      "$ref": "#/$defs/unsupported"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "textOrEmpty": {
      "type": "string",
      "maxLength": 200
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Relative size used for layout only; never displayed."
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wordmark",
        "tokenSet"
      ],
      "properties": {
        "wordmark": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Text shown top-left."
        },
        "tokenSet": {
          "type": "string",
          "enum": [
            "frontier-desk",
            "16x9"
          ],
          "description": "Named token set registered in TOKEN_SETS in engine.mjs. To add a firm, register a new set there and extend this enum."
        },
        "footerUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Bottom-left text. Default frontierdesk.ai/intel."
        }
      }
    },
    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeLabel",
        "dateLabel",
        "source"
      ],
      "properties": {
        "typeLabel": {
          "$ref": "#/$defs/text",
          "description": "Top-right label, for example Deal, Credit facility, Our call."
        },
        "dateLabel": {
          "$ref": "#/$defs/text",
          "description": "Publication date as 'Mon D, YYYY'. Checked against --date, not against the body."
        },
        "source": {
          "$ref": "#/$defs/text",
          "description": "Footer source line, verbatim from the note's Sources list."
        }
      }
    },
    "rowsHeader": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/text"
        }
      ],
      "items": false,
      "minItems": 2
    },
    "rows": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "sub",
          "value",
          "meter"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/text"
          },
          "sub": {
            "$ref": "#/$defs/text"
          },
          "value": {
            "$ref": "#/$defs/textOrEmpty"
          },
          "meter": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "Bar fill percent (geometry, not displayed) or null for no bar."
          }
        }
      }
    },
    "common": {
      "type": "object",
      "required": [
        "spec_version",
        "brand",
        "chrome",
        "headline"
      ],
      "properties": {
        "spec_version": {
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "brand": {
          "$ref": "#/$defs/brand"
        },
        "chrome": {
          "$ref": "#/$defs/chrome"
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "description": "The note title, verbatim."
        },
        "subhead": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "rowsHeader": {
          "$ref": "#/$defs/rowsHeader"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "name",
        "n"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "n": {
          "$ref": "#/$defs/weight"
        }
      }
    },
    "deal": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "type",
        "visual",
        "rowsHeader",
        "rows",
        "subhead"
      ],
      "properties": {
        "type": {
          "enum": [
            "deal_breakdown"
          ]
        },
        "visual": {
          "oneOf": [
            {
              "$ref": "#/$defs/tiles"
            },
            {
              "$ref": "#/$defs/amount"
            }
          ]
        },
        "rowsHeader": {
          "$ref": "#/$defs/rowsHeader"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        }
      }
    },
    "credit": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "type",
        "visual",
        "rowsHeader",
        "rows",
        "subhead"
      ],
      "properties": {
        "type": {
          "enum": [
            "lender_watch"
          ]
        },
        "visual": {
          "oneOf": [
            {
              "$ref": "#/$defs/facility"
            },
            {
              "$ref": "#/$defs/facilities"
            },
            {
              "$ref": "#/$defs/bars"
            }
          ]
        },
        "rowsHeader": {
          "$ref": "#/$defs/rowsHeader"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        }
      }
    },
    "call": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "type",
        "visual",
        "rowsHeader",
        "rows",
        "subhead"
      ],
      "properties": {
        "type": {
          "enum": [
            "the_call"
          ]
        },
        "visual": {
          "oneOf": [
            {
              "$ref": "#/$defs/chart"
            },
            {
              "$ref": "#/$defs/callcard"
            }
          ]
        },
        "rowsHeader": {
          "$ref": "#/$defs/rowsHeader"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unsupported_type": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "deal_breakdown",
              "lender_watch",
              "the_call",
              "build_out_tracker",
              "week_in_five",
              "owner_explainer",
              "explainer",
              "field_report",
              "other"
            ]
          }
        },
        "unsupported_layout": {
          "type": "string",
          "enum": [
            "deal_breakdown",
            "lender_watch",
            "the_call",
            "build_out_tracker",
            "week_in_five",
            "owner_explainer",
            "explainer",
            "field_report",
            "other"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "unsupported_type"
          ],
          "not": {
            "required": [
              "unsupported_layout"
            ]
          }
        },
        {
          "required": [
            "unsupported_layout",
            "reason"
          ],
          "not": {
            "required": [
              "unsupported_type"
            ]
          }
        }
      ]
    },
    "types": {
      "enum": [
        "deal_breakdown",
        "lender_watch",
        "the_call",
        "build_out_tracker",
        "week_in_five",
        "owner_explainer",
        "explainer",
        "field_report",
        "other"
      ]
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "big",
        "caption",
        "points",
        "threshold",
        "endLabel",
        "axis"
      ],
      "properties": {
        "kind": {
          "const": "chart"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "big": {
          "$ref": "#/$defs/text"
        },
        "caption": {
          "$ref": "#/$defs/text"
        },
        "seriesId": {
          "type": "string",
          "description": "Provenance only; not displayed."
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "y",
              "m",
              "v"
            ],
            "properties": {
              "y": {
                "type": "integer"
              },
              "m": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "v": {
                "type": "number"
              }
            }
          }
        },
        "threshold": {
          "type": "number",
          "description": "Must equal the last point's v (the dashed line is drawn at the last reading)."
        },
        "endLabel": {
          "$ref": "#/$defs/text"
        },
        "axis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startYear",
            "endYear",
            "endLabel"
          ],
          "description": "Chart time axis. Required so no displayed text is hardcoded in the template.",
          "properties": {
            "startYear": {
              "type": "integer"
            },
            "endYear": {
              "type": "integer"
            },
            "endLabel": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "meta": {
          "$ref": "#/$defs/text",
          "description": "Optional units and observation frequency line, for example \"Monthly, billions of dollars\". Words from the note."
        }
      }
    },
    "tiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "total",
        "tiles"
      ],
      "properties": {
        "kind": {
          "const": "tiles"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "total": {
          "$ref": "#/$defs/text"
        },
        "tiles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "description": "Large first part, second part, and the contingent part (hatched).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "n"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "n": {
                "$ref": "#/$defs/weight"
              },
              "hatch": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "facility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "total",
        "drawn",
        "rest"
      ],
      "properties": {
        "kind": {
          "const": "facility"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "total": {
          "$ref": "#/$defs/text"
        },
        "drawn": {
          "$ref": "#/$defs/part"
        },
        "rest": {
          "$ref": "#/$defs/part"
        }
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "big",
        "name"
      ],
      "properties": {
        "kind": {
          "const": "amount"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "kicker": {
          "$ref": "#/$defs/text"
        },
        "big": {
          "$ref": "#/$defs/text",
          "description": "The one stated amount, or a short phrase such as \"Not stated\" when the note says the figure is not stated."
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "hatch": {
          "type": "boolean",
          "description": "true when big is a not-stated phrase rather than a figure."
        },
        "hatchLast": {
          "type": "boolean"
        },
        "facts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "name"
            ],
            "properties": {
              "value": {
                "$ref": "#/$defs/text"
              },
              "name": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "facilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "facilities"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "detail",
              "n"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "detail": {
                "$ref": "#/$defs/text"
              },
              "n": {
                "$ref": "#/$defs/weight"
              },
              "hatch": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "bars": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "big",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "bars"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "big": {
          "$ref": "#/$defs/text"
        },
        "caption": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value",
              "n"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "n": {
                "$ref": "#/$defs/weight"
              },
              "hatch": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "callcard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "big",
        "caption",
        "threshold",
        "base"
      ],
      "properties": {
        "kind": {
          "const": "callcard"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "big": {
          "$ref": "#/$defs/text"
        },
        "caption": {
          "$ref": "#/$defs/text"
        },
        "meta": {
          "$ref": "#/$defs/text"
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "name"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/text"
            },
            "name": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "name",
            "hit",
            "total"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/text"
            },
            "name": {
              "$ref": "#/$defs/text"
            },
            "hit": {
              "type": "number",
              "minimum": 0
            },
            "total": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "statement"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "The note's key statement, copied verbatim."
        },
        "points": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "text"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 260
              }
            }
          }
        }
      }
    },
    "stmt": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "type",
        "visual",
        "subhead"
      ],
      "properties": {
        "type": {
          "enum": [
            "deal_breakdown",
            "lender_watch",
            "the_call",
            "build_out_tracker",
            "week_in_five",
            "owner_explainer",
            "explainer",
            "field_report",
            "other"
          ]
        },
        "visual": {
          "oneOf": [
            {
              "$ref": "#/$defs/statement"
            }
          ]
        },
        "rowsHeader": {
          "$ref": "#/$defs/rowsHeader"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        }
      }
    },
    "gBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "rows",
        "fuelLabel",
        "total",
        "fuel"
      ],
      "properties": {
        "sub3": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value",
              "unit",
              "count",
              "n"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "unit": {
                "$ref": "#/$defs/text"
              },
              "count": {
                "$ref": "#/$defs/text"
              },
              "n": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "fuelLabel": {
          "$ref": "#/$defs/text"
        },
        "total": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fuel": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "n"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "n": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "gExplain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bars",
        "tiles",
        "loc",
        "lender",
        "qHead",
        "questions"
      ],
      "properties": {
        "bars": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value",
              "n",
              "kind"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "n": {
                "$ref": "#/$defs/weight"
              },
              "kind": {
                "enum": [
                  "solid",
                  "t2",
                  "hatch"
                ]
              }
            }
          }
        },
        "tiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "big",
              "text",
              "kind"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/text"
              },
              "big": {
                "$ref": "#/$defs/text"
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "kind": {
                "enum": [
                  "t2",
                  "hatch"
                ]
              }
            }
          }
        },
        "loc": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "lender": {
          "$ref": "#/$defs/text"
        },
        "qHead": {
          "$ref": "#/$defs/text"
        },
        "questions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "gWeek": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "th",
        "rows"
      ],
      "properties": {
        "th": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "rows": {
          "type": "array",
