# Placeholders only. Do not put real secrets in this file.
# .env* is gitignored. Copy the names you need into the host environment.

# Session cookie (HS256, 30 days). Required for /login and /team.
AUTH_SECRET=

# Google OAuth for /login and /team. Required with AUTH_SECRET.
# Register this redirect URI on the OAuth client:
# https://16x9.ai/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Explicit admin allowlist for /login and /team.
# Unset or blank: nelson.sanmiguel@16x9.ai, info@16x9.ai.
# A comma-separated list of full addresses replaces that default.
# There is no @16x9.ai wildcard. A domain, or @domain, does not admit anyone.
X9_TEAM_EMAILS=

# Notices after a team decision. Unset sends nothing. Not used for sign-in.
X9_TEAM_NOTIFY_EMAILS=

# Optional Amazon SES for those notices. Unset leaves delivery not_configured.
# Sign-in does not send mail.
SES_FROM_EMAIL=
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mycel 16x9 ecosystem 318b5ffd-6706-492f-912b-37ed4bc28a55
MYCEL_API_BASE=
MYCEL_16X9_API_KEY=
MYCEL_16X9_ECOSYSTEM_ID=
MYCEL_16X9_ORG_ID=

# Vercel Blob for page-post PNGs. Prefix x9-page-posts/. Not an FD token.
BLOB_READ_WRITE_TOKEN=

# Bearer for the plain visual sweep. Refused while unset. Vercel sends this on cron requests.
CRON_SECRET=

# Bearer for GET /api/cron/page-post-visuals?post= and ?force=1.
# The plain sweep is not scheduled: vercel.json has no cron entry.
X9_PAGE_VISUALS_SECRET=

# Live LinkedIn posting. Anything other than the string true does not publish.
X9_LINKEDIN_PUBLISHER_ENABLED=

# Local review data when Mycel is unset. Leave unset in production.
X9_TEAM_FIXTURES=
X9_INTEL_FIXTURES=

# Optional local Chromium for the visual renderer.
X9_CHROME_PATH=
