# Placeholders only. Do not put real secrets in this file.
# .env* is gitignored. Copy the names you need into the host environment.

# Session and email OTP (HS256). Required for /team sign-in.
AUTH_SECRET=

# Amazon SES. Unset means the code is not emailed (delivery: not_configured).
SES_FROM_EMAIL=
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local sign-in only. Ignored when NODE_ENV=production.
X9_OTP_DEV_ECHO=

# Team gate. Defaults: nelson.sanmiguel@16x9.ai and anyone at 16x9.ai.
# Notices are sent only when the notify list is non-empty.
X9_TEAM_EMAILS=
X9_TEAM_NOTIFY_EMAILS=

# Mycel 16x9 ecosystem 318b5ffd-6706-492f-912b-37ed4bc28a55
MYCEL_API_BASE=
MYCEL_16X9_API_KEY=
MYCEL_16X9_ECOSYSTEM_ID=
MYCEL_16X9_ORG_ID=

# Vercel Blob for page-post PNGs. Prefix x9-page-posts/. Not an FD token.
BLOB_READ_WRITE_TOKEN=

# Bearer for the plain visual sweep. Refused while unset. Vercel sends this on cron requests.
CRON_SECRET=

# Bearer for GET /api/cron/page-post-visuals?post= and ?force=1.
# The plain sweep is not scheduled: vercel.json has no cron entry.
X9_PAGE_VISUALS_SECRET=

# Live LinkedIn posting. Anything other than the string true does not publish.
X9_LINKEDIN_PUBLISHER_ENABLED=

# Local review data when Mycel is unset. Leave unset in production.
X9_TEAM_FIXTURES=
X9_INTEL_FIXTURES=

# Optional local Chromium for the visual renderer.
X9_CHROME_PATH=
